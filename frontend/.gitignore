
# ==========================================
# MARSWALK - Git Ignore Configuration
# ==========================================

# ------------------------------------------
# Node.js / React / Vite
# ------------------------------------------
node_modules/
frontend/node_modules/

dist/
dist-ssr/
frontend/dist/

*.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ------------------------------------------
# Editor directories and files
# ------------------------------------------
.vscode/
!.vscode/extensions.json

.idea/
.DS_Store
Thumbs.db

*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------
# Python / Virtual Environments
# ------------------------------------------
venv/
env/
ENV/
.venv/

backend/venv/
backend/env/
backend/ENV/
backend/.venv/

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/

.ipynb_checkpoints/

# ------------------------------------------
# Environment Variables / Sensitive Keys
# ------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------
# Python Logs
# ------------------------------------------
*.log

# ------------------------------------------
# Model Artifacts / Large Model Weights
# ------------------------------------------
*.pth
*.pt

model_artifacts/
backend/model_artifacts/

# ------------------------------------------
# Temporary Files
# ------------------------------------------
*.tmp
*.bak
*.swp
*.swo

# ------------------------------------------
# Build and Cache Files
# ------------------------------------------
.cache/
.parcel-cache/
.next/
coverage/


# Backend generated data and caches
backend/__pycache__/
# Ignore Python cache directories everywhere
**/__pycache__/
**/*.py[cod]

# Ignore backend virtual environment
/backend/venv/